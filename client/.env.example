# =============================================================================
# client/.env.example  (Vite environment variables)
#
# Vite only exposes variables that start with VITE_ to the browser bundle.
# Copy to `.env.local` for development and set the SAME variable in the
# Vercel/Netlify build settings for production.
# =============================================================================

# Base URL of the deployed back-end API — NO trailing slash, NO /api suffix
# (the client appends /api/... itself).
VITE_API_URL=http://localhost:5000

# Production example:
# VITE_API_URL=https://capstone-portfolio-api.onrender.com
