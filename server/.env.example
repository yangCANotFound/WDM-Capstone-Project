# =============================================================================
# server/.env.example
# Copy this file to `server/.env` and fill in real values.  NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# =============================================================================

# --- Database (MongoDB Atlas) ------------------------------------------------
# Atlas -> Database -> Connect -> Drivers -> copy the SRV string.
# Replace <username>, <password> and the db name (capstone) as shown.
# URL-encode special characters in the password (@ -> %40, # -> %23, : -> %3A).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/capstone?retryWrites=true&w=majority

# --- Authentication ----------------------------------------------------------
# Signing secret for JWTs. Must be long and random (>= 32 chars).
# Generate one:
#   PowerShell: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   bash:       openssl rand -hex 48
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
# Token lifetime (jsonwebtoken `expiresIn` format): 1h | 12h | 7d | 30d
JWT_EXPIRE=30d

# --- Server ------------------------------------------------------------------
# Render/Heroku inject PORT automatically; 5000 is the local default.
PORT=5000
NODE_ENV=development

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Production: your deployed front-end URL ONLY (no trailing slash).
# Local dev:  http://localhost:5173
# '*' would allow every origin (not recommended once you have the real URL).
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Optional ----------------------------------------------------------------
# Global requests allowed per IP per 15 minutes (default 300)
RATE_LIMIT_MAX=300

# Credentials used by `npm run seed` (optional overrides)
SEED_ADMIN_EMAIL=admin@portfolio.dev
SEED_ADMIN_PASSWORD=admin123
